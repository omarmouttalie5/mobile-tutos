classDiagram
    class Category {
        -int id
        -string name
        -string color
        -string icon
    }
    class User {
        -int id
        -string email
        -string password
        -string role
    }
    class Author {
        -int id
        -string lastName
        -string firstName
        -string biography
        -string avatar
    }
    class Article {
        -int id
        -string title
        -string content
        -string status
        -DateTime creationDate
    }

    User "1" -- "0..1" Author : has profile
    Author "1" -- "0..*" Article : writes
    Category "1" -- "0..*" Article : contains
